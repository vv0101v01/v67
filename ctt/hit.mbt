///|
/// # Higher inductive types
///
/// A higher inductive type is generated by point constructors *and* path
/// constructors, and its Kan structure needs one more ingredient:
/// **formal composition**.  A box in `S¹` whose walls are loops has no lid
/// among the constructors, so the lid is a new formal term `hcomp`, and
/// every eliminator must have a clause for it.  This is how cubical Agda
/// makes a HIT fibrant, and it is what keeps `S¹` from collapsing to a set.
///
/// | type | point constructors | path constructors |
/// |---|---|---|
/// | `S¹` | `base` | `loop : Path base base` |
/// | `Susp A` | `north`, `south` | `merid : A → Path north south` |
/// | `∥A∥` | `inc : A → ∥A∥` | `sq : Π x y. Path x y` |
///
/// Each recursor below takes the **target type** explicitly, because the
/// formal-composition clause has to compose the images of the walls in
/// that target, and a HIT eliminator is not determined by its point image
/// alone.
///
/// ## What the clauses mean
///
/// On a point constructor the recursor returns the given datum.  On a path
/// constructor it returns the given *path*, so the β-rule holds on the
/// nose, not up to a further homotopy.  On a formal composite it composes
/// the images of the walls — which is forced, since the recursor must
/// preserve composition to be a function out of a Kan complex.  On a
/// neutral it is stuck.

///|
/// Composition in a HIT.  `comp` has already applied regularity, so what
/// reaches here is a box that genuinely needs a new lid.
fn comp_hit(fam : Fam, i : Int32, tube : Tube, cap : Val) -> Val {
  let ty = fam.at(@cubical.DOne)
  if tube.is_constant(i) {
    return cap
  }
  VHComp(ty, tube, cap)
}

///|
/// `loop : Path S¹ base base`.  The endpoints are `base` definitionally.
pub fn circle_loop() -> Val {
  VPLam(DClo::{ f: fn(r) { vloop(r) }, })
}

///|
pub fn vloop(r : Dim) -> Val {
  match r {
    @cubical.DZero | @cubical.DOne => VBase
    _ => VLoop(r)
  }
}

///|
/// # `S¹`-recursion
///
/// `circle_rec B b l base = b`, `circle_rec B b l (loop i) = l i`, and
/// formal composites go to composites of the images.
pub fn circle_rec(bty : Val, b : Val, l : Val, x : Val) -> Val {
  match x {
    VBase => b
    VLoop(r) => vpapp(l, r)
    VHComp(_, tube, cap) => {
      let brs : Array[TubeBr] = []
      for br in tube.branches {
        let tm = br.tm
        brs.push(TubeBr::{
          cof: br.cof,
          tm: DClo::{ f: fn(r) { circle_rec(bty, b, l, tm.at(r)) }, },
        })
      }
      comp(
        fam_const(bty),
        0,
        Tube::{ branches: brs, },
        circle_rec(bty, b, l, cap),
      )
    }
    _ => VCircRec(bty, b, l, x)
  }
}

///|
/// # `Susp A`-recursion
///
/// `merid a` is a path from `north` to `south`, so its image is the given
/// `m a`, and the endpoints of `m a` must be `n` and `s`.
pub fn susp_rec(bty : Val, n : Val, s : Val, m : Val, x : Val) -> Val {
  match x {
    VNorth => n
    VSouth => s
    VMerid(_, a, r) => vpapp(vapp(m, a), r)
    VHComp(_, tube, cap) => {
      let brs : Array[TubeBr] = []
      for br in tube.branches {
        let tm = br.tm
        brs.push(TubeBr::{
          cof: br.cof,
          tm: DClo::{ f: fn(r) { susp_rec(bty, n, s, m, tm.at(r)) }, },
        })
      }
      comp(
        fam_const(bty),
        0,
        Tube::{ branches: brs, },
        susp_rec(bty, n, s, m, cap),
      )
    }
    _ => VSuspRec(bty, n, s, m, x)
  }
}

///|
pub fn susp_merid(a : Val, x : Val) -> Val {
  VPLam(DClo::{
    f: fn(r) {
      match r {
        @cubical.DZero => VNorth
        @cubical.DOne => VSouth
        _ => VMerid(a, x, r)
      }
    },
  })
}

///|
/// # The truncation's path constructor
///
/// `sq x y : Path ∥A∥ x y` for *any* two points.  This is the whole content
/// of the truncation: it is the free proposition on `A`.
pub fn trunc_sq(a : Val, x : Val, y : Val) -> Val {
  VPLam(DClo::{
    f: fn(r) {
      match r {
        @cubical.DZero => x
        @cubical.DOne => y
        _ => VSq(a, x, y, r)
      }
    },
  })
}

///|
/// # `isProp ∥A∥`
///
/// Read off the path constructor.
pub fn trunc_is_prop(a : Val) -> Val {
  VLam(Clo::{ f: fn(x) { VLam(Clo::{ f: fn(y) { trunc_sq(a, x, y) }, }) }, })
}

///|
/// # The universal property of truncation
///
/// To define `∥A∥ → B` for `B` a **proposition**, it suffices to give
/// `f : A → B`.  The path-constructor clause is forced: `sq x y` must go to
/// a path from `rec x` to `rec y`, and `B` being a proposition supplies
/// exactly one, namely `prop (rec x) (rec y)`.
///
/// This is the eliminator that makes truncation useful, and its
/// well-typedness *is* the reason the target must be a proposition: for a
/// general `B` there is no such path, which is why `∥A∥ → B` does not
/// exist in general.
pub fn trunc_rec(bty : Val, f : Val, prop : Val, x : Val) -> Val {
  match x {
    VInc(a) => vapp(f, a)
    VSq(_, u, v, r) => {
      let ru = trunc_rec(bty, f, prop, u)
      let rv = trunc_rec(bty, f, prop, v)
      vpapp(vapp(vapp(prop, ru), rv), r)
    }
    VHComp(_, tube, cap) => {
      let brs : Array[TubeBr] = []
      for br in tube.branches {
        let tm = br.tm
        brs.push(TubeBr::{
          cof: br.cof,
          tm: DClo::{ f: fn(r) { trunc_rec(bty, f, prop, tm.at(r)) }, },
        })
      }
      comp(
        fam_const(bty),
        0,
        Tube::{ branches: brs, },
        trunc_rec(bty, f, prop, cap),
      )
    }
    _ => VTruncRec(bty, f, prop, x)
  }
}

///|
/// # An inhabited proposition is contractible
///
/// `∥A∥` is a proposition by `sq`; given a point it is therefore
/// contractible, with that point as centre and `sq` as the contraction.
/// Applied to `S¹` this says `∥S¹∥` is contractible — the circle is
/// connected in the mere sense, which is all that is true without
/// choosing a path.
pub fn trunc_contr(a : Val, pt : Val) -> Val {
  VPair(pt, vapp(trunc_is_prop(a), pt))
}

///|
/// `isContr ∥S¹∥`, with centre `inc base`.
pub fn circle_trunc_contr() -> Val {
  trunc_contr(VCircle, VInc(VBase))
}

///|
/// # The coequalizer — a quotient-style HIT
///
/// For `f, g : A → B`, `Coeq f g` is `B` with a path `rel a` from
/// `inc (f a)` to `inc (g a)` for every `a : A`.  It is the universal
/// recipient of a map out of `B` that equalises `f` and `g` *up to a
/// path*, and it is the shape every set-quotient is built from.
///
/// Unlike a quotient by a relation, the coequalizer adds paths without
/// truncating: `Coeq f f` is `B` with a **loop** at each `f a`, not `B`
/// again.  The kernel must therefore keep `rel a` distinct from `refl`,
/// and the tests check that it does.
pub fn coeq_rel(f : Val, g : Val, a : Val) -> Val {
  let fa = VCoeqInc(vapp(f, a))
  let ga = VCoeqInc(vapp(g, a))
  VPLam(DClo::{
    f: fn(r) {
      match r {
        @cubical.DZero => fa
        @cubical.DOne => ga
        _ => VCoeqRel(a, r)
      }
    },
  })
}

///|
/// # `Coeq`-recursion
///
/// To define `Coeq f g → C` it suffices to give `h : B → C` together with
/// `p : Π(a:A). Path C (h (f a)) (h (g a))`.  The path-constructor clause
/// is forced to be `p a`, so the β-rule holds on the nose.
pub fn coeq_rec(bty : Val, h : Val, p : Val, x : Val) -> Val {
  match x {
    VCoeqInc(b) => vapp(h, b)
    VCoeqRel(a, r) => vpapp(vapp(p, a), r)
    VHComp(_, tube, cap) => {
      let brs : Array[TubeBr] = []
      for br in tube.branches {
        let tm = br.tm
        brs.push(TubeBr::{
          cof: br.cof,
          tm: DClo::{ f: fn(r) { coeq_rec(bty, h, p, tm.at(r)) }, },
        })
      }
      comp(
        fam_const(bty),
        0,
        Tube::{ branches: brs, },
        coeq_rec(bty, h, p, cap),
      )
    }
    _ => VCoeqRec(bty, h, p, x)
  }
}
