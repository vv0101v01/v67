name = "arena/moonmath"

version = "0.1.0"

readme = "README.md"

license = "Apache-2.0"

keywords = [
  "mathematics",
  "homotopy",
  "infinity-category",
  "cubical-type-theory",
  "univalence",
  "moonbit",
]

preferred_target = "wasm"

description = "Derived mathematics and a computational cubical type theory kernel in MoonBit: F2 homology, A-infinity/E-infinity, derived moduli, and univalence with type-directed Kan composition, general fibre-contractible equivalences, ua-beta/ua-eta, HITs, and an unbounded, bidirectional, internally symmetric structure."
