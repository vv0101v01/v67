///|
using @cubical {
  type CubeTy,
  type PartialElem,
  comp,
  check_partial,
  face_cube,
  face_cof,
  subcube_digits,
}

///|
/// **Local complementability.**  A cubical type is locally completable at a
/// box when every compatible open box admits a filler.  This is the Kan
/// condition, localised to a single box, and it is the exact hypothesis
/// that `comp` needs.  Because everything is finite, "every box" is a
/// finite quantifier and the property is *decidable*.
///
/// The name matches the lifting-property formulation: a partial element on
/// a cofibration `phi` is a "germ", and complementing it means extending
/// the germ to a global element.  Locally completable = every germ extends.
#derive(Debug, Eq)
pub struct BoxProblem {
  ty : CubeTy
  dir : Int32
  tube : PartialElem
  cap : Int32
}

///|
pub fn BoxProblem::new(
  ty : CubeTy,
  dir : Int32,
  tube : PartialElem,
  cap : Int32,
) -> BoxProblem {
  BoxProblem::{ ty, dir, tube, cap, }
}

///|
/// Is this box well formed (compatible tube, cap agreeing on the overlap)?
pub fn BoxProblem::well_formed(self : BoxProblem) -> Bool {
  if !check_partial(self.ty, self.tube) {
    return false
  }
  let cap_stage = face_cube(self.ty.n, self.dir, 0)
  if self.cap < 0 || self.cap >= self.ty.card[cap_stage] {
    return false
  }
  // the cap must agree with the tube where both are defined
  for k in 0..<self.tube.comps.length() {
    let meet = @cubical.meet_cube(cap_stage, self.tube.comps[k], self.ty.n)
    if meet >= 0 {
      let from_cap = self.ty.restrict(cap_stage, meet, self.cap)
      let from_tube = self.ty.restrict(
        self.tube.comps[k],
        meet,
        self.tube.vals[k],
      )
      if from_cap != from_tube {
        return false
      }
    }
  }
  true
}

///|
/// Complement the box: produce a filler, or report that none exists.
/// This is the decision procedure for local complementability at a box.
pub fn BoxProblem::complement(self : BoxProblem) -> Int32? {
  if !self.well_formed() {
    return None
  }
  match comp(self.ty, self.dir, self.tube, self.cap) {
    None => None
    Some(r) => Some(r.filler)
  }
}

///|
/// The result of a local complementability audit over a whole type.
#derive(Debug, Eq)
pub struct ComplementReport {
  boxes : Int32
  complementable : Int32
  failures : Int32
  unique_lids : Int32
}

///|
pub fn ComplementReport::is_kan(self : ComplementReport) -> Bool {
  self.failures == 0
}

///|
/// The cofibration generated by a list of subcube codes: the union of the
/// faces they name.  Built with the interval algebra, so it is a genuine
/// element of the free De Morgan algebra on the direction literals.
fn tube_cof(comps : Array[Int32], n : Int32) -> @cubical.Cof {
  let mut acc = @cubical.CBot
  for s in comps {
    let digits = subcube_digits(s, n)
    let mut c = @cubical.CTop
    for d in 0..<n {
      if digits[d] != 2 {
        c = c.conj(face_cof(d, digits[d]))
      }
    }
    acc = acc.disj(c)
  }
  acc
}

///|
/// Audit local complementability of a type in one direction, over *all*
/// tubes with at most `tube_size` components on the side faces and all
/// caps.  Exponential in the tube size, so the bound is explicit — this is
/// a finite model check, not a proof for arbitrary types.
pub fn audit_direction(
  ty : CubeTy,
  dir : Int32,
  tube_size~ : Int32 = 1,
) -> ComplementReport {
  let n = ty.n
  let cap_stage = face_cube(n, dir, 0)
  // side faces: those with the composition direction free
  let sides : Array[Int32] = []
  for d in 0..<n {
    if d == dir {
      continue
    }
    for eps in 0..<2 {
      sides.push(face_cube(n, d, eps))
    }
  }
  let mut boxes = 0
  let mut ok = 0
  let mut bad = 0
  let mut uniq = 0
  // enumerate tubes of size 0..tube_size by recursive descent
  fn go(
    chosen : Array[Int32],
    vals : Array[Int32],
    start : Int32,
    left : Int32,
  ) -> Unit {
    if left == 0 {
      let phi = tube_cof(chosen, n)
      let tube = PartialElem::new(phi, chosen[:].to_owned(), vals[:].to_owned())
      for cap in 0..<ty.card[cap_stage] {
        let problem = BoxProblem::new(ty, dir, tube, cap)
        if problem.well_formed() {
          boxes = boxes + 1
          match comp(ty, dir, tube, cap) {
            None => bad = bad + 1
            Some(r) => {
              ok = ok + 1
              if r.unique_lid {
                uniq = uniq + 1
              }
            }
          }
        }
      }
    } else {
      for i in start..<sides.length() {
        let sc = sides[i]
        for v in 0..<ty.card[sc] {
          chosen.push(sc)
          vals.push(v)
          go(chosen, vals, i + 1, left - 1)
          ignore(vals.pop())
          ignore(chosen.pop())
        }
      }
    }
  }

  for k in 0..<=tube_size {
    go([], [], 0, k)
  }
  ComplementReport::{
    boxes,
    complementable: ok,
    failures: bad,
    unique_lids: uniq,
  }
}

///|
/// Audit all directions.
pub fn audit_type(ty : CubeTy, tube_size~ : Int32 = 1) -> ComplementReport {
  let mut total = ComplementReport::{
    boxes: 0,
    complementable: 0,
    failures: 0,
    unique_lids: 0,
  }
  for d in 0..<ty.n {
    let r = audit_direction(ty, d, tube_size~)
    total = ComplementReport::{
      boxes: total.boxes + r.boxes,
      complementable: total.complementable + r.complementable,
      failures: total.failures + r.failures,
      unique_lids: total.unique_lids + r.unique_lids,
    }
  }
  total
}

///|
/// **Local sections of a covering.**  A covering map `p : E -> B` has local
/// sections: over each point of `B` there is a neighbourhood over which
/// `p` splits.  For a graph cover the "neighbourhood" of a vertex is its
/// star, and a local section picks one preimage edge for each base edge.
/// This is the same lifting property as local complementability, one
/// dimension down, and it is what makes the cover a fibre bundle.
#derive(Debug, Eq)
pub struct GraphCover {
  base : Space
  total : Space
  proj : Array[Int32]
  /// `edge_map[e]` = the base edge under total edge e
  edge_map : Array[Int32]
}

///|
pub fn GraphCover::new(
  base : Space,
  total : Space,
  proj : Array[Int32],
  edge_map : Array[Int32],
) -> GraphCover {
  GraphCover::{ base, total, proj, edge_map, }
}

///|
/// Is this a covering map: for every total vertex, the edges at it map
/// bijectively onto the edges at its projection.
pub fn GraphCover::is_covering(self : GraphCover) -> Bool {
  for v in 0..<self.total.nverts {
    let b = self.proj[v]
    // for each base edge-end at b, exactly one total edge-end at v over it,
    // with the same orientation, and its endpoints projecting correctly
    for e in 0..<self.base.nedges() {
      let (ba, bc) = self.base.edges[e]
      for side in 0..<2 {
        let endpoint = if side == 0 { ba } else { bc }
        if endpoint != b {
          continue
        }
        let mut hits = 0
        for te in 0..<self.total.nedges() {
          if self.edge_map[te] != e {
            continue
          }
          let (ta, tc) = self.total.edges[te]
          let at = if side == 0 { ta } else { tc }
          if at != v {
            continue
          }
          if self.proj[ta] != ba || self.proj[tc] != bc {
            return false
          }
          hits = hits + 1
        }
        if hits != 1 {
          return false
        }
      }
    }
    // and no total edge-end at v lies over an edge not at b
    for te in 0..<self.total.nedges() {
      let (ta, tc) = self.total.edges[te]
      if ta == v || tc == v {
        let (ba, bc) = self.base.edges[self.edge_map[te]]
        if ba != b && bc != b {
          return false
        }
      }
    }
  }
  true
}

///|
/// A local section over the star of a base vertex `b`, at a chosen
/// preimage `v`: for each base edge at `b`, the unique total edge at `v`
/// over it.  Returns the chosen total edges, indexed by base edge.
pub fn GraphCover::local_section(
  self : GraphCover,
  b : Int32,
  v : Int32,
) -> Array[Int32]? {
  if self.proj[v] != b {
    return None
  }
  // One slot per base edge-END (2 per edge), because a loop at b has two
  // ends there and a covering must lift both, generally to distinct edges.
  let out = Array::make(2 * self.base.nedges(), -1)
  for e in 0..<self.base.nedges() {
    let (ba, bc) = self.base.edges[e]
    for side in 0..<2 {
      let endpoint = if side == 0 { ba } else { bc }
      if endpoint != b {
        continue
      }
      let mut found = -1
      for te in 0..<self.total.nedges() {
        if self.edge_map[te] != e {
          continue
        }
        let (ta, tc) = self.total.edges[te]
        let at = if side == 0 { ta } else { tc }
        if at != v {
          continue
        }
        if found >= 0 {
          return None
        }
        found = te
      }
      if found < 0 {
        return None
      }
      out[2 * e + side] = found
    }
  }
  Some(out)
}

///|
/// Every point of the total space admits a local section: the covering
/// property, stated as "local complementability of the lifting problem".
pub fn GraphCover::has_local_sections(self : GraphCover) -> Bool {
  for v in 0..<self.total.nverts {
    match self.local_section(self.proj[v], v) {
      None => return false
      Some(_) => ()
    }
  }
  true
}

///|
/// The `k`-fold cover of the circle as a graph cover.
pub fn circle_cover(k : Int32) -> GraphCover {
  let base = space_circle()
  let total = space_cycle(k)
  let proj = Array::make(k, 0)
  let edge_map = Array::make(k, 0)
  GraphCover::{ base, total, proj, edge_map, }
}

///|
/// The `k`-fold cover of the figure eight: each of the two loops lifts to
/// `k` edges cycling through the fibre.  Its total space is a wedge-like
/// graph with `k` vertices and `2k` edges.
pub fn wedge_cover(k : Int32, nloops : Int32) -> GraphCover {
  let base = space_wedge(nloops)
  let es : Array[(Int32, Int32)] = []
  let em : Array[Int32] = []
  for l in 0..<nloops {
    for i in 0..<k {
      es.push((i, (i + 1) % k))
      em.push(l)
    }
  }
  let total = Space::new(k, es)
  GraphCover::{ base, total, proj: Array::make(k, 0), edge_map: em, }
}
